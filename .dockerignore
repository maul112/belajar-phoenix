# Node modules di assets (akan di-npm ci di container)
assets/node_modules/

# Environment files lokal
.env
.env.*
!.env.production.example

# File besar / tidak relevan
*.zip
*.sql
*.ez
erl_crash.dump
npm-debug.log

# IDE / Editor
.idea/
*.swp
*.swo
