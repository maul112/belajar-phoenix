<div class="min-h-screen bg-slate-50 dark:bg-slate-900">
  <.navbarMentor active_tab={:keluhan_magang} current_user={@current_user}>
    <Layouts.flash_group flash={@flash} />
    
    <div class="max-w-7xl mx-auto px-4 py-8 space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Keluhan Anak Didik</h1>
          <p class="text-slate-500 text-sm mt-1">Daftar keluhan spesifik dari peserta magang bimbingan Anda</p>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm">
        <div class="p-4 border-b border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50">
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-2">Filter:</span>
            <button phx-click="filter" phx-value-category="" class={["px-4 py-2 rounded-full text-sm font-medium transition-all shadow-sm border", @category == "" && "bg-slate-800 text-white border-slate-800", @category != "" && "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 border-slate-200 dark:border-slate-700"]}>Semua</button>
            <button phx-click="filter" phx-value-category="Fasilitas" class={["px-4 py-2 rounded-full text-sm font-medium transition-all shadow-sm border", @category == "Fasilitas" && "bg-purple-600 text-white border-purple-600", @category != "Fasilitas" && "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-purple-50 hover:text-purple-700 hover:border-purple-200 border-slate-200 dark:border-slate-700"]}>Fasilitas</button>
            <button phx-click="filter" phx-value-category="Teknis" class={["px-4 py-2 rounded-full text-sm font-medium transition-all shadow-sm border", @category == "Teknis" && "bg-blue-600 text-white border-blue-600", @category != "Teknis" && "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-200 border-slate-200 dark:border-slate-700"]}>Teknis</button>
            <button phx-click="filter" phx-value-category="Lingkungan" class={["px-4 py-2 rounded-full text-sm font-medium transition-all shadow-sm border", @category == "Lingkungan" && "bg-green-600 text-white border-green-600", @category != "Lingkungan" && "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-green-50 hover:text-green-700 hover:border-green-200 border-slate-200 dark:border-slate-700"]}>Lingkungan</button>
            <button phx-click="filter" phx-value-category="Lainnya" class={["px-4 py-2 rounded-full text-sm font-medium transition-all shadow-sm border", @category == "Lainnya" && "bg-orange-600 text-white border-orange-600", @category != "Lainnya" && "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-orange-50 hover:text-orange-700 hover:border-orange-200 border-slate-200 dark:border-slate-700"]}>Lainnya</button>
          </div>
        </div>

        <div class="divide-y divide-slate-100 dark:divide-slate-700" id="complaints" phx-update="stream">
          <div id="empty-complaints" class="hidden only:block text-center py-12 text-slate-500 dark:text-slate-400">
            Belum ada keluhan di kategori ini.
          </div>
          <%= for {id, complaint} <- @streams.complaints do %>
            <div id={id} class="p-6 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                      <%= complaint.category %>
                    </span>
                    <span class="text-xs text-slate-500 flex items-center gap-1">
                      <.icon name="hero-clock" class="w-3.5 h-3.5" />
                      <%= Calendar.strftime(complaint.inserted_at, "%d %b %Y, %H:%M") %>
                    </span>
                  </div>
                  
                  <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-1">
                    <%= complaint.participation.user.name %>
                  </h4>
                  <p class="text-sm text-slate-600 dark:text-slate-400 mb-4 whitespace-pre-wrap"><%= complaint.content %></p>
                </div>

                <div class="flex flex-col items-end gap-2">
                  <%= if complaint.is_resolved do %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold bg-green-50 text-green-700 border border-green-200">
                      <.icon name="hero-check-circle" class="w-4 h-4" />
                      Resolved
                    </span>
                    <button type="button" phx-click="toggle_resolve" phx-value-id={complaint.id} class="text-xs text-slate-400 hover:text-slate-600 font-medium underline">
                      Tandai Belum Selesai
                    </button>
                  <% else %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                      <.icon name="hero-clock" class="w-4 h-4" />
                      Pending
                    </span>
                    <button type="button" phx-click="toggle_resolve" phx-value-id={complaint.id} class="text-xs text-blue-600 hover:text-blue-700 font-medium underline">
                      Tandai Selesai
                    </button>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
      </div>
        <div class="p-4 border-t border-slate-100 dark:border-slate-700 flex justify-between items-center bg-slate-50 dark:bg-slate-900/50">
          <p class="text-sm text-slate-500">
            Halaman <%= @current_page %> dari <%= @total_pages %>
          </p>
          <div>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
              <.link patch={~p"/mentor/keluhan-magang?category=#{@category}&page=#{max(1, @current_page - 1)}"} class={["relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm font-medium transition-colors", @current_page <= 1 && "opacity-50 pointer-events-none text-slate-400 dark:text-slate-500", @current_page > 1 && "text-slate-500 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700"]}>
                <span class="sr-only">Previous</span>
                <.icon name="hero-chevron-left" class="h-5 w-5" />
              </.link>
              <.link patch={~p"/mentor/keluhan-magang?category=#{@category}&page=#{min(@total_pages, @current_page + 1)}"} class={["relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm font-medium transition-colors", @current_page >= @total_pages && "opacity-50 pointer-events-none text-slate-400 dark:text-slate-500", @current_page < @total_pages && "text-slate-500 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700"]}>
                <span class="sr-only">Next</span>
                <.icon name="hero-chevron-right" class="h-5 w-5" />
              </.link>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </.navbarMentor>
</div>
