<.navbarMentor active_tab={:presensi}>
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Scanner Presensi Bimbingan</h1>
      <p class="text-slate-500 text-sm mt-1"><%= Calendar.strftime(@today, "%d %B %Y") %></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Scanner -->
      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="p-4 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
            <h3 class="font-bold text-slate-900 flex items-center gap-2">
                <.icon name="hero-camera" class="w-5 h-5 text-blue-600" />
                Scanner QR
            </h3>
            <div class="flex items-center gap-1 bg-slate-200/60 p-1 rounded-lg">
              <button phx-click="set_mode" phx-value-mode="check_in" class={["px-3 py-1.5 text-xs font-semibold rounded-md transition-all", @scan_mode == "check_in" && "bg-white text-blue-600 shadow-sm ring-1 ring-slate-900/5", @scan_mode != "check_in" && "text-slate-500 hover:text-slate-700"]}>
                Check-in
              </button>
              <button phx-click="set_mode" phx-value-mode="check_out" class={["px-3 py-1.5 text-xs font-semibold rounded-md transition-all", @scan_mode == "check_out" && "bg-white text-blue-600 shadow-sm ring-1 ring-slate-900/5", @scan_mode != "check_out" && "text-slate-500 hover:text-slate-700"]}>
                Check-out
              </button>
            </div>
        </div>
        <div class="p-6">
            <%= if @scan_result do %>
                <div class={["mb-4 p-3 rounded-lg text-sm font-medium", elem(@scan_result, 0) == :ok && "bg-green-100 text-green-700", elem(@scan_result, 0) == :error && "bg-red-100 text-red-700"]}>
                    <%= elem(@scan_result, 1) %>
                </div>
            <% end %>
            <div id="qr-reader" phx-hook="QrScanner" phx-update="ignore" class="w-full rounded-xl overflow-hidden relative min-h-[250px] flex flex-col items-center justify-center text-slate-700 text-sm bg-slate-50 border-2 border-dashed border-slate-200 p-4">
                <p class="text-slate-500 flex flex-col items-center gap-2">
                    <.icon name="hero-video-camera" class="w-8 h-8 opacity-50" />
                    Mempersiapkan Scanner...
                </p>
            </div>
        </div>
      </div>

      <!-- List Presensi -->
      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="p-4 border-b border-slate-100 bg-slate-50 flex flex-col gap-4">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-900 flex items-center gap-2">
                  <.icon name="hero-users" class="w-5 h-5 text-indigo-600" />
                  Hari Ini
              </h3>
              <button phx-click="open_manual_modal" class="text-xs font-semibold px-3 py-1.5 bg-slate-200 text-slate-700 rounded-md hover:bg-slate-300 transition-colors">
                  + Absen Manual
              </button>
            </div>
            
            <form phx-change="filter_presences" class="flex flex-col sm:flex-row gap-2 w-full">
              <div class="relative flex-1">
                <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none">
                    <.icon name="hero-magnifying-glass" class="h-4 w-4 text-slate-400" />
                </div>
                <input type="text" name="search" value={@search} phx-debounce="300" placeholder="Cari nama..." class="block w-full pl-8 pr-3 py-1.5 border border-slate-300 rounded-lg text-xs focus:ring-blue-500 focus:border-blue-500" />
              </div>
              <select name="opening" class="block w-full sm:w-auto py-1.5 px-3 border border-slate-300 bg-white rounded-lg text-xs focus:ring-blue-500 focus:border-blue-500">
                <option value="">Semua Lowongan</option>
                <%= for {title, _} <- @grouped_bimbingan do %>
                  <option value={title} selected={@opening == title}><%= title %></option>
                <% end %>
              </select>
            </form>
        </div>
        <div class="divide-y divide-slate-100" id="presences-list" phx-update="stream">
          <%= for {id, presence} <- @streams.presences do %>
            <div id={id} class="p-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-500 to-indigo-600 flex items-center justify-center text-white text-sm font-bold">
                    {String.at(presence.participation.user.name, 0)}
                  </div>
                <div>
                  <p class="font-semibold text-slate-900 text-sm"><%= presence.participation.user.name %></p>
                  <p class="text-xs text-slate-500 mt-1">
                    In: <%= if presence.check_in, do: Calendar.strftime(presence.check_in, "%H:%M"), else: "--:--" %> | 
                    Out: <%= if presence.check_out, do: Calendar.strftime(presence.check_out, "%H:%M"), else: "--:--" %>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <span class={["px-2.5 py-1 rounded-full text-xs font-medium", status_color(presence.status)]}>
                    <%= status_label(presence.status) %>
                </span>
                <div class="flex gap-2">
                  <button type="button" phx-click="edit_presence" phx-value-id={presence.id} class="text-slate-400 hover:text-blue-600 transition-colors" title="Edit">
                    <.icon name="hero-pencil-square" class="w-4 h-4" />
                  </button>
                  <button type="button" phx-click="delete_presence" phx-value-id={presence.id} data-confirm="Hapus presensi ini?" class="text-slate-400 hover:text-red-600 transition-colors cursor-pointer" title="Hapus">
                    <.icon name="hero-trash" class="w-4 h-4" />
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</.navbarMentor>

<%= if @show_manual_modal do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden" phx-click-away="close_manual_modal">
      <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
        <h3 class="font-bold text-slate-900">Absen Manual</h3>
        <button phx-click="close_manual_modal" class="text-slate-400 hover:text-slate-600">
          <.icon name="hero-x-mark" class="w-5 h-5" />
        </button>
      </div>
      <form phx-submit="save_manual" class="p-6 space-y-4">
        <%= if @manual_error do %>
          <div class="p-3 bg-red-50 text-red-700 text-sm font-medium rounded-lg border border-red-100">
            <%= @manual_error %>
          </div>
        <% end %>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">Filter Kategori</label>
          <div class="flex flex-wrap gap-2 mb-4">
            <button type="button" phx-click="select_category" phx-value-category="Semua" class={["px-3 py-1 text-xs font-semibold rounded-full border transition-colors", @selected_category == "Semua" && "bg-blue-100 border-blue-200 text-blue-700", @selected_category != "Semua" && "bg-slate-50 border-slate-200 text-slate-600 hover:bg-slate-100"]}>
              Semua
            </button>
            <%= for {title, _} <- @grouped_bimbingan do %>
              <button type="button" phx-click="select_category" phx-value-category={title} class={["px-3 py-1 text-xs font-semibold rounded-full border transition-colors", @selected_category == title && "bg-blue-100 border-blue-200 text-blue-700", @selected_category != title && "bg-slate-50 border-slate-200 text-slate-600 hover:bg-slate-100"]}>
                <%= title %>
              </button>
            <% end %>
          </div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Pilih Peserta</label>
          <select name="participation_id" required class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:ring-blue-500 focus:border-blue-500">
            <option value="">-- Pilih Peserta Magang --</option>
            <%= for {title, interns} <- @grouped_bimbingan do %>
              <%= if @selected_category == "Semua" or @selected_category == title do %>
                <%= for intern <- interns do %>
                  <%= if is_nil(@edit_presence) and intern.id not in @already_present_ids do %>
                    <option value={intern.id}><%= intern.user.name %></option>
                  <% else %>
                    <%= if @edit_presence && @edit_presence.participation_id == intern.id do %>
                      <option value={intern.id} selected><%= intern.user.name %></option>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Status Kehadiran</label>
          <select name="status" required class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:ring-blue-500 focus:border-blue-500">
            <option value="present" selected={is_nil(@edit_presence) || @edit_presence.status == "present"}>Hadir</option>
            <option value="sick" selected={@edit_presence && @edit_presence.status == "sick"}>Sakit</option>
            <option value="permit" selected={@edit_presence && @edit_presence.status == "permit"}>Izin</option>
            <option value="absent" selected={@edit_presence && @edit_presence.status == "absent"}>Alpha</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Jam Check-In</label>
            <input type="time" name="check_in" value={if @edit_presence && @edit_presence.check_in, do: Calendar.strftime(@edit_presence.check_in, "%H:%M"), else: ""} class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Jam Check-Out</label>
            <input type="time" name="check_out" value={if @edit_presence && @edit_presence.check_out, do: Calendar.strftime(@edit_presence.check_out, "%H:%M"), else: ""} class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:ring-blue-500 focus:border-blue-500" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Catatan Tambahan (Opsional)</label>
          <textarea name="notes" rows="2" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:ring-blue-500 focus:border-blue-500" placeholder="Cth: Izin karena urusan keluarga"><%= if @edit_presence, do: @edit_presence.notes %></textarea>
        </div>
        <div class="pt-2 flex gap-3">
          <button type="button" phx-click="close_manual_modal" class="flex-1 px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            Batal
          </button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">
            Simpan Presensi
          </button>
        </div>
      </form>
    </div>
  </div>
<% end %>
