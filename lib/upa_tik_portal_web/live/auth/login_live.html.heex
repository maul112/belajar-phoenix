<div class="min-h-screen bg-slate-50 dark:bg-slate-800 flex flex-col justify-center items-center py-12 px-4 relative overflow-hidden">
  <%!-- Subtle aesthetic background decoration --%>
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none w-full h-full flex justify-center items-center">
    <div class="absolute w-[600px] h-[600px] rounded-full bg-blue-50/50 blur-[100px] mix-blend-multiply opacity-60 animate-pulse transition-all duration-1000"></div>
    <div class="absolute translate-x-1/3 translate-y-1/3 w-[500px] h-[500px] rounded-full bg-indigo-50/40 blur-[80px] mix-blend-multiply opacity-40"></div>
  </div>

  <div class="relative z-10 w-full max-w-md">
    <div class="bg-white dark:bg-slate-900 p-8 sm:p-12 shadow-sm border border-slate-200 dark:border-slate-700 rounded-3xl backdrop-blur-sm">

      <%!-- Logo & Header --%>
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center p-3 bg-white dark:bg-slate-900 rounded-2xl mb-5 shadow-sm border border-slate-100">
          <img class="h-14 w-auto object-contain" src={~p"/images/utm_logo.png"} alt="UTM Logo">
        </div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          UPA TIK <span class="text-blue-600">Portal</span>
        </h2>
        <p class="mt-2 text-xs text-slate-500 font-medium">
          Sistem Informasi Manajemen Terpadu<br/>Universitas Trunojoyo Madura
        </p>
      </div>

      <div class="w-full h-px bg-slate-100 mb-8"></div>

      <%!-- Action section --%>
      <div class="space-y-6">
        <div class="text-center">
           <h3 class="text-sm font-bold text-slate-900 dark:text-white">Akses Masuk Panel</h3>
           <p class="text-xs text-slate-500 mt-1">Gunakan akun Google universitas Anda</p>
        </div>

        <div>
          <a href="/auth/google" class="w-full flex justify-center items-center py-3.5 px-6 border border-slate-300 rounded-xl text-sm font-semibold text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:bg-slate-800 hover:border-blue-300 hover:text-blue-700 hover:shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-blue-100 gap-3">
            <svg class="h-5 w-5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            <span>Masuk Sistem</span>
          </a>
        </div>

        <div class="mt-6 flex justify-center text-center">
           <div class="inline-flex items-center text-[10px] font-semibold text-slate-500 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700">
              <svg class="w-3.5 h-3.5 mr-1.5 text-blue-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
              Hanya Akun Resmi UTM
           </div>
        </div>
      </div>
    </div>

    <%!-- Footer --%>
    <div class="mt-8 text-center px-4">
      <p class="text-[10px] text-slate-500 font-medium leading-relaxed">
        © 2026 Universitas Trunojoyo Madura<br/>
        <span class="text-slate-400">Unit Pelaksana Akademik TIK</span>
      </p>
    </div>
  </div>

</div>
