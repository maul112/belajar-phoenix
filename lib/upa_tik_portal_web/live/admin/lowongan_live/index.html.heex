<div class="min-h-screen">
  <.navbarAdmin current_user={@current_user} active_tab={:lowongan}>
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row justify-between items-center mb-8 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 shadow-sm">
        <div class="text-center lg:text-left mb-4 lg:mb-0">
          <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Lowongan Magang</h1>
          <p class="text-slate-500 mt-1 text-sm">Kelola semua daftar lowongan magang aktif di portal ini.</p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 w-full lg:w-auto">
          <form phx-change="filter" class="flex flex-col sm:flex-row gap-3 items-center w-full sm:w-auto">
            <div class="relative w-full sm:w-64">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <.icon name="hero-magnifying-glass" class="h-5 w-5 text-slate-400" />
                </div>
                <input type="text" name="search" value={@search} phx-debounce="300" placeholder="Cari posisi atau departemen..." class="block w-full pl-10 pr-3 py-2 bg-white dark:bg-slate-900 border border-slate-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
            </div>
            <div class="w-full sm:w-auto">
                <select name="status" class="block w-full py-2 px-3 border border-slate-300 bg-white dark:bg-slate-900 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors">
                    <option value="">Semua Status</option>
                    <option value="true" selected={@status == "true"}>Open</option>
                    <option value="false" selected={@status == "false"}>Closed</option>
                </select>
            </div>
          </form>
          <.link 
            patch={~p"/admin/lowongan/new"} 
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-all"
          >
            <.icon name="hero-plus" class="w-4 h-4 mr-2" />
            Tambah
          </.link>
        </div>
      </div>

      <div class="overflow-hidden shadow-sm border border-slate-200 dark:border-slate-700 rounded-xl bg-white dark:bg-slate-900">
      <.table id="internship-openings" rows={@streams.lowongans}>
        
        <:col :let={{_id, item}} label="Posisi & Perusahaan">
          <div class="flex flex-col">
            <span class="font-bold text-base hover:text-blue-600 transition-colors"><%= item.title %></span>
            <%!-- Saya pertahankan strukturmu, tapi kamu bisa ganti text bawahnya jika ini typo --%>
            <span class="text-xs text-slate-500"><%= item.title %></span>
          </div>
        </:col>

        <:col :let={{_id, item}} label="Divisi">
          <div class="flex items-center text-slate-600">
            <.icon name="hero-map-pin" class="w-4 h-4 mr-1" />
            <%= if item.division, do: item.division.name, else: "-" %>
          </div>
        </:col>

        <:col :let={{_id, item}} label="Status">
          <%!-- Catatan Informatika: Ecto biasanya menyimpan boolean sebagai true/false, bukan string "true". 
              Saya tambahkan pengecekan ganda agar aplikasimu aman dari bug tipe data. --%>
          <span class={[
            "inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset",
            item.is_active in [true, "true"] && "bg-green-50 text-green-700 ring-green-600/20",
            item.is_active in [false, "false"] && "bg-red-50 text-red-700 ring-red-600/20"
          ]}>
            <%= if item.is_active in [true, "true"], do: "Open", else: "Closed" %>
          </span>
        </:col>

        <:col :let={{_id, item}} label="Tanggal Posting">
          <%= Calendar.strftime(item.inserted_at, "%d %b %Y") %>
        </:col>

        <:col :let={{_id, item}} label="Kuota">
          <%= item.quota %> Kuota
        </:col>

        <:action :let={{_id, item}}>
          <div class="flex justify-end gap-3">
            <.link patch={~p"/admin/lowongan/#{item.id}/edit"} class="hover:text-blue-600 transition-colors" title="Edit">
              <.icon name="hero-pencil-square" class="w-5 h-5" />
            </.link>
            
            <button 
              phx-click="delete" 
              phx-value-id={item.id} 
              data-confirm="Hapus lowongan ini?"
              class="hover:text-red-600 transition-colors cursor-pointer"
              title="Hapus"
            >
              <.icon name="hero-trash" class="w-5 h-5" />
            </button>
          </div>
        </:action>
        
      </.table>

      <div :if={!@any_lowongan?} class="py-20 text-center border-t border-slate-100">
        <.icon name="hero-briefcase" class="mx-auto h-12 w-12 text-slate-300" />
        <h3 class="mt-2 text-sm font-semibold text-slate-900 dark:text-white">Belum ada lowongan</h3>
        <p class="mt-1 text-sm text-slate-500">Mulai dengan membuat lowongan magang pertama Anda.</p>
      </div>

      <%!-- Pagination --%>
      <div :if={@total_pages >= 1} class="border-t border-slate-200 dark:border-slate-700 px-4 py-3 flex items-center justify-between sm:px-6">
        <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
          <div>
            <p class="text-sm text-slate-700 dark:text-slate-300">
              Halaman <span class="font-medium"><%= @page %></span> dari <span class="font-medium"><%= @total_pages %></span>
            </p>
          </div>
          <div>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
              <.link navigate={~p"/admin/lowongan?page=#{max(1, @page - 1)}&search=#{@search}&status=#{@status}"} class={["relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300 bg-white dark:bg-slate-900 text-sm font-medium", @page == 1 && "text-slate-300 pointer-events-none", @page > 1 && "text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800"]}>
                <span class="sr-only">Previous</span>
                <.icon name="hero-chevron-left" class="h-5 w-5" />
              </.link>
              <.link navigate={~p"/admin/lowongan?page=#{min(@total_pages, @page + 1)}&search=#{@search}&status=#{@status}"} class={["relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300 bg-white dark:bg-slate-900 text-sm font-medium", @page == @total_pages && "text-slate-300 pointer-events-none", @page < @total_pages && "text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800"]}>
                <span class="sr-only">Next</span>
                <.icon name="hero-chevron-right" class="h-5 w-5" />
              </.link>
            </nav>
          </div>
        </div>
        </div>
      </div>
    </div>
  </.navbarAdmin>
</div>