<.navbarAdmin current_user={@current_user} active_tab={:pengajuan}>
  <Layouts.flash_group flash={@flash} />
  
  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 shadow-sm">
      <div class="text-center md:text-left mb-4 md:mb-0">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Permohonan Aktivasi</h1>
        <p class="text-slate-500 mt-1 text-sm"><%= Enum.count(@requests) %> Entri Pengguna Ditemukan</p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
        <form phx-change="search" class="relative w-full sm:w-64">
          <input type="text" name="q" value={@search} placeholder="Cari Mahasiswa/NIM..."
            class="w-full pl-10 pr-4 py-2 bg-white dark:bg-slate-900 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors"/>
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <.icon name="hero-magnifying-glass" class="w-4 h-4" />
          </div>
        </form>

        <div class="flex bg-slate-100 dark:bg-slate-800/50 p-1 rounded-lg border border-slate-200 dark:border-slate-700 w-full sm:w-auto">
           <%= for {label, val} <- [{"Semua", "all"}, {"Pending", "pending"}] do %>
             <button phx-click="filter" phx-value-status={val}
               class={["flex-1 sm:flex-none px-4 py-1.5 rounded-md text-xs font-semibold transition-colors", if(@filter == val, do: "bg-white dark:bg-slate-700 text-blue-600 dark:text-white shadow-sm ring-1 ring-slate-900/5 dark:ring-slate-900/20", else: "text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")]}>
               <%= label %>
             </button>
           <% end %>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead class="bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
            <tr>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Data Pengguna</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Permintaan Akun</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">Tipe</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">Status</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <%= for request <- filtered_requests(@requests, @filter, @search) do %>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center text-slate-600 dark:text-slate-400 font-bold text-lg">
                      <%= String.at(request.full_name, 0) %>
                    </div>
                    <div>
                      <p class="font-bold text-slate-900 dark:text-white text-sm"><%= request.full_name %></p>
                      <p class="text-xs text-slate-500 mt-0.5"><%= request.nim %></p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div>
                    <p class="text-sm font-semibold text-slate-700 dark:text-slate-300"><%= request.email_requested %></p>
                    <p class="text-xs text-slate-500 mt-1">Waktu: <%= Calendar.strftime(request.inserted_at, "%d/%m/%y %H:%M") %></p>
                  </div>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400">
                    <%= format_type(request.request_type) %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class={["inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", status_class(request.status)]}>
                    <%= status_label(request.status) %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex justify-end gap-2">
                    <.link navigate={~p"/admin/pengajuan/#{request.id}"} class="inline-flex items-center gap-1 px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors text-xs font-semibold">
                      <span>Proses</span>
                      <.icon name="hero-arrow-right" class="w-3 h-3" />
                    </.link>
                    <button phx-click="delete" phx-value-id={request.id} data-confirm="Hapus data pengajuan ini secara permanen?" class="p-1.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-red-500 dark:text-red-400 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors">
                      <.icon name="hero-trash" class="w-4 h-4" />
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
            <%= if Enum.empty?(filtered_requests(@requests, @filter, @search)) do %>
              <tr>
                <td colspan="5" class="px-6 py-16 text-center border-t border-slate-200 dark:border-slate-700">
                  <.icon name="hero-document-magnifying-glass" class="mx-auto h-12 w-12 text-slate-300 dark:text-slate-600 mb-3" />
                  <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Data tidak ditemukan</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</.navbarAdmin>
