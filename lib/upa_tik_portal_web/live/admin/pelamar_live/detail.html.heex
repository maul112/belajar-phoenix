<.navbarAdmin current_user={@current_user} active_tab={:pelamar}>
  <Layouts.flash_group flash={@flash} />

  <div class="max-w-7xl mx-auto px-4 py-8 space-y-6">
    <.link navigate={~p"/admin/pelamar"} class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-blue-600 transition-colors">
      <.icon name="hero-arrow-left" class="w-4 h-4" />
      Kembali ke Daftar Pelamar
    </.link>

    <%!-- Header --%>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-blue-500 to-indigo-600 flex items-center justify-center text-white text-xl font-bold">
            {String.at(@participation.user.name, 0)}
          </div>
          <div>
            <h1 class="text-xl font-bold text-slate-900 dark:text-white">{@participation.user.name}</h1>
            <p class="text-sm text-slate-500">{@participation.user.email}</p>
          </div>
        </div>
        <span class={["text-sm font-semibold px-3 py-1.5 rounded-full", status_color(@participation.status)]}>
          {status_label(@participation.status)}
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <%!-- Info Lamaran --%>
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm space-y-3">
        <h3 class="font-semibold text-slate-800 dark:text-slate-200">Informasi Lamaran</h3>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-500">Posisi</span>
            <span class="font-medium text-slate-900 dark:text-white">{@participation.internship_opening.title}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Departemen</span>
            <span class="text-slate-700 dark:text-slate-300">{(if @participation.internship_opening.division, do: @participation.internship_opening.division.name, else: "-")}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Universitas</span>
            <span class="text-slate-700 dark:text-slate-300">Universitas Trunojoyo Madura</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Program Studi</span>
            <span class="text-slate-700 dark:text-slate-300">{@participation.major}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Mulai</span>
            <span class="text-slate-700 dark:text-slate-300">{Calendar.strftime(@participation.internship_opening.start_date, "%d %b %Y")}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Selesai</span>
            <span class="text-slate-700 dark:text-slate-300">{Calendar.strftime(@participation.internship_opening.end_date, "%d %b %Y")}</span>
          </div>
        </div>
      </div>

      <%!-- Dokumen --%>
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm space-y-3">
        <h3 class="font-semibold text-slate-800 dark:text-slate-200">Dokumen Lamaran</h3>
        <div class="space-y-2">
          <%= for {label, url} <- [
            {"CV", @participation.cv_url},
            {"Portfolio", @participation.portfolio_url},
            {"Surat Pengantar", @participation.surat_pengantar_url},
            {"Transkrip Nilai", @participation.transkrip_nilai_url}
          ] do %>
            <div class="flex items-center justify-between text-sm py-1.5 border-b border-slate-100 last:border-0">
              <span class="text-slate-600">{label}</span>
              <%= if url && url != "" do %>
                <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-800 font-medium">
                  <.icon name="hero-arrow-top-right-on-square" class="w-3.5 h-3.5" />
                  Lihat
                </a>
              <% else %>
                <span class="text-slate-400 italic text-xs">Tidak ada</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Ubah Status --%>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
      <h3 class="font-semibold text-slate-800 dark:text-slate-200 mb-4">Ubah Status Lamaran</h3>
      <div class="flex flex-wrap gap-3">
        <%= for {status, label, btn_class} <- [
          {"applied", "Menunggu Review", "border-blue-300 text-blue-700 hover:bg-blue-50"},
          {"interview", "Tahap Interview", "border-yellow-300 text-yellow-700 hover:bg-yellow-50"},
          {"accepted", "Terima", "border-green-400 text-green-700 hover:bg-green-50 bg-green-50"},
          {"rejected", "Tolak", "border-red-300 text-red-700 hover:bg-red-50"}
        ] do %>
          <button
            id={"status-btn-#{status}"}
            phx-click={if status == "rejected" and @participation.status != "rejected", do: show_modal("reject-modal"), else: "update_status"}
            phx-value-status={status}
            disabled={@participation.status in ["accepted", "rejected"]}
            data-confirm={if status == "accepted" and @participation.status != "accepted", do: "Apakah Anda yakin ingin menerima pelamar ini? Aksi ini akan mengubah status pelamar lain yang aktif (jika ada).", else: false}
            class={[
              "px-4 py-2 text-sm font-semibold rounded-xl border transition-colors",
              btn_class,
              @participation.status == status && "ring-2 ring-offset-1 ring-current opacity-80",
              @participation.status in ["accepted", "rejected"] && @participation.status != status && "opacity-50 cursor-not-allowed grayscale"
            ]}
          >
            <%= if @participation.status == status do %>
              <.icon name="hero-check" class="w-3.5 h-3.5 inline mr-1" />
            <% end %>
            {label}
          </button>
        <% end %>
      </div>
    </div>

    <.modal id="reject-modal">
      <div class="p-4 text-center">
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <.icon name="hero-exclamation-triangle" class="w-8 h-8 text-red-600" />
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Tolak Lamaran?</h3>
        <p class="text-slate-500 text-sm mb-6">Apakah Anda yakin ingin menolak pelamar ini? Setelah ditolak, status lamaran tidak dapat diubah kembali.</p>
        <div class="flex justify-center gap-3">
          <button type="button" phx-click={hide_modal("reject-modal")} class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 dark:text-slate-300 rounded-xl font-medium transition-colors">
            Batal
          </button>
          <button type="button" phx-click={JS.push("update_status", value: %{status: "rejected"}) |> hide_modal("reject-modal")} class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-xl font-medium transition-colors">
            Ya, Tolak
          </button>
        </div>
      </div>
    </.modal>

    <%!-- Assign Mentor --%>
    <%= if @participation.status == "accepted" do %>
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
        <h3 class="font-semibold text-slate-800 dark:text-slate-200 mb-3">Assign Mentor</h3>
        <form phx-submit="assign_mentor" class="flex items-center gap-3">
          <select
            name="mentor_id"
            id="mentor-select"
            class="flex-1 rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">-- Belum ditentukan --</option>
            <%= for mentor <- @mentors do %>
              <option value={mentor.id} selected={to_string(mentor.id) == @selected_mentor_id}>
                {mentor.name} ({mentor.email})
              </option>
            <% end %>
          </select>
          <button type="submit" id="save-mentor-btn" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors whitespace-nowrap">
            Simpan
          </button>
        </form>
        <%= if @participation.mentor do %>
          <p class="text-xs text-slate-500 mt-2">Mentor saat ini: <span class="font-medium">{@participation.mentor.name}</span></p>
        <% end %>
      </div>
    <% end %>

    <%!-- Audit Logs --%>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm mt-6">
      <h3 class="font-semibold text-slate-800 dark:text-slate-200 mb-4 flex items-center gap-2">
        <.icon name="hero-clock" class="w-5 h-5 text-slate-500" />
        Riwayat Perubahan Status
      </h3>
      
      <%= if Enum.empty?(@audit_logs) do %>
        <p class="text-sm text-slate-500 italic">Belum ada riwayat perubahan status.</p>
      <% else %>
        <div class="space-y-4">
          <%= for log <- @audit_logs do %>
            <div class="flex gap-3 text-sm">
              <div class="mt-0.5">
                <div class="w-2 h-2 rounded-full bg-blue-500 mt-1.5"></div>
              </div>
              <div class="flex-1">
                <p class="text-slate-700 dark:text-slate-300">
                  Status diubah menjadi <span class="font-medium text-slate-900 dark:text-white">{status_label(log.to_status)}</span>
                  <%= if log.changed_by do %>
                    oleh <span class="font-medium text-slate-900 dark:text-white">{log.changed_by.name}</span>
                  <% end %>
                </p>
                <p class="text-xs text-slate-500">{Calendar.strftime(log.inserted_at |> DateTime.add(7, :hour), "%d %B %Y, %H:%M WIB")}</p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</.navbarAdmin>
