<.navbarAdmin active_tab={:keluhan}>
  <Layouts.flash_group flash={@flash} />
  
  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
      <div class="text-center md:text-left">
        <h1 class="text-2xl font-bold text-slate-900">Pusat Keluhan</h1>
        <p class="text-slate-500 mt-1 text-sm">Laporan Kendala Mahasiswa</p>
      </div>
      <div class="flex items-center gap-4 mt-4 md:mt-0">
        <div class="flex flex-col items-center px-4 py-2 bg-blue-50 rounded-xl border border-blue-100">
          <span class="text-xs font-semibold text-blue-600">Baru</span>
          <span class="text-xl font-bold text-blue-700"><%= @baru %></span>
        </div>
        <div class="flex flex-col items-center px-4 py-2 bg-amber-50 rounded-xl border border-amber-100">
          <span class="text-xs font-semibold text-amber-600">Diproses</span>
          <span class="text-xl font-bold text-amber-700"><%= @diproses %></span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Data Pelapor</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Masalah Utama</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">Status</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <%= for keluhan <- @keluhans do %>
              <% {badge_class, badge_text} = status_badge(keluhan.status) %>
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-slate-100 rounded-full flex items-center justify-center text-slate-600 font-bold text-lg">
                      <%= String.at(keluhan.user.name, 0) %>
                    </div>
                    <div>
                      <p class="font-bold text-slate-900 text-sm"><%= keluhan.user.name %></p>
                      <p class="text-xs text-slate-500 mt-0.5">
                        <%= Calendar.strftime(keluhan.inserted_at, "%d %b %Y") %>
                      </p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div>
                    <p class="text-sm font-bold text-slate-900"><%= keluhan.subject %></p>
                    <p class="text-xs text-slate-500 mt-1 line-clamp-1"><%= keluhan.description %></p>
                  </div>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class={["px-3 py-1 rounded-full text-xs font-semibold", badge_class]}>
                    <%= badge_text %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <button phx-click="select" phx-value-id={keluhan.id} class="inline-flex items-center gap-1 px-3 py-1.5 bg-white border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors text-xs font-semibold">
                    <span>Tinjau</span>
                    <.icon name="hero-arrow-right" class="w-3 h-3" />
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        
        <%= if Enum.empty?(@keluhans) do %>
          <div class="p-16 text-center border-t border-slate-200">
            <.icon name="hero-inbox" class="mx-auto h-12 w-12 text-slate-300 mb-3" />
            <p class="text-sm font-medium text-slate-500">Antrean keluhan kosong</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= if @selected_keluhan do %>
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl overflow-hidden border border-slate-200">
        <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
          <div>
            <h3 class="text-lg font-bold text-slate-900">Detail Kasus</h3>
            <p class="text-slate-500 text-xs font-medium mt-0.5">ID Keluhan: #<%= @selected_keluhan.id %></p>
          </div>
          <button phx-click="close" class="text-slate-400 hover:text-slate-600 transition-colors p-1">
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <div class="p-6 max-h-[75vh] overflow-y-auto custom-scrollbar">
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
              <p class="text-xs font-semibold text-slate-500 mb-1">Pelapor</p>
              <p class="font-bold text-slate-900 text-sm"><%= @selected_keluhan.user.name %></p>
              <p class="text-xs text-blue-600 mt-0.5"><%= @selected_keluhan.user.email %></p>
            </div>
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
              <p class="text-xs font-semibold text-slate-500 mb-1">Subjek Masalah</p>
              <p class="font-bold text-slate-900 text-sm"><%= @selected_keluhan.subject %></p>
            </div>
          </div>

          <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 mb-6">
            <p class="text-xs font-semibold text-slate-500 mb-2">Kronologi Kendala</p>
            <p class="text-slate-700 text-sm leading-relaxed"><%= @selected_keluhan.description %></p>
          </div>

          <div class="mb-6">
            <h4 class="text-sm font-bold text-slate-900 border-b border-slate-200 pb-2 mb-4">Riwayat Percakapan</h4>
            <div class="space-y-4 max-h-[250px] overflow-y-auto custom-scrollbar pr-2 mb-4">
              <%= if Enum.empty?(@selected_keluhan.messages) do %>
                <div class="text-center text-slate-400 text-xs italic py-4">Belum ada percakapan.</div>
              <% else %>
                <%= for msg <- @selected_keluhan.messages do %>
                  <div class={["flex", if(msg.is_admin, do: "justify-end", else: "justify-start")]}>
                    <div class={["max-w-[80%] rounded-xl p-3 text-sm", if(msg.is_admin, do: "bg-blue-600 text-white rounded-tr-sm", else: "bg-slate-100 text-slate-800 rounded-tl-sm")]}>
                      <p class="text-[10px] font-semibold mb-1 opacity-70"><%= if msg.is_admin, do: "Admin", else: msg.user.name %></p>
                      <p class="whitespace-pre-wrap"><%= msg.content %></p>
                      <p class="text-[9px] text-right mt-1 opacity-60"><%= Calendar.strftime(msg.inserted_at, "%d %b %Y %H:%M") %></p>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
            
            <form phx-submit="send_message" class="flex gap-2">
              <input type="text" name="new_message" value={@new_message} phx-change="update_message" placeholder="Ketik balasan..." autocomplete="off"
                     class="flex-1 px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
              <button type="submit" class="px-4 py-2 bg-slate-900 text-white rounded-lg text-sm font-semibold hover:bg-slate-800 transition-colors">Kirim</button>
            </form>
          </div>

          <form phx-submit="update_status">
            <h4 class="text-sm font-bold text-slate-900 border-b border-slate-200 pb-2 mb-3">Update Status Laporan</h4>
            <div class="flex gap-2">
              <button type="button" phx-click="update_status" phx-value-status="baru" class="flex-1 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-600 hover:bg-slate-50 transition-colors">Baru</button>
              <button type="button" phx-click="update_status" phx-value-status="diproses" class="flex-1 py-2 rounded-lg text-xs font-semibold bg-amber-50 border border-amber-200 text-amber-700 hover:bg-amber-100 transition-colors">Diproses</button>
              <button type="button" phx-click="update_status" phx-value-status="selesai" class="flex-1 py-2 rounded-lg text-xs font-semibold bg-green-50 border border-green-200 text-green-700 hover:bg-green-100 transition-colors">Selesai</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% end %>
</.navbarAdmin>
