<.navbarAdmin current_user={@current_user} active_tab={:intern}>
  <Layouts.flash_group flash={@flash} />

  <div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8 space-y-6">
    <.link navigate={~p"/admin/intern"} class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-blue-600 transition-colors">
      <.icon name="hero-arrow-left" class="w-4 h-4" />
      Kembali ke Daftar Intern
    </.link>

    <%!-- Header Info --%>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-blue-500 to-indigo-600 flex items-center justify-center text-white text-lg font-bold">
            {String.at(@participation.user.name, 0)}
          </div>
          <div>
            <h1 class="text-xl font-bold text-slate-900 dark:text-white">{@participation.user.name}</h1>
            <p class="text-sm text-slate-500">{@participation.user.email}</p>
            <p class="text-xs text-slate-400 mt-0.5">Universitas Trunojoyo Madura · {@participation.major}</p>
          </div>
        </div>

        <div class="flex flex-col gap-2 sm:items-end">
          <p class="text-sm font-semibold text-slate-700 dark:text-slate-300">{@participation.internship_opening.title}</p>
          <p class="text-xs text-slate-500">{(if @participation.internship_opening.division, do: @participation.internship_opening.division.name, else: "-")}</p>
          <p class="text-xs text-slate-400">
            {Calendar.strftime(@participation.internship_opening.start_date, "%d %b %Y")} – {Calendar.strftime(@participation.internship_opening.end_date, "%d %b %Y")}
          </p>
        </div>
      </div>

      <%!-- Stats Bar --%>
      <div class="mt-5 pt-5 border-t border-slate-100 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <div>
          <p class="text-xl font-bold text-green-600">{@presence_stats.present}</p>
          <p class="text-xs text-slate-500">Hadir</p>
        </div>
        <div>
          <p class="text-xl font-bold text-blue-600">{@presence_stats.sick}</p>
          <p class="text-xs text-slate-500">Sakit</p>
        </div>
        <div>
          <p class="text-xl font-bold text-yellow-600">{@presence_stats.permit}</p>
          <p class="text-xs text-slate-500">Izin</p>
        </div>
        <div>
          <p class="text-xl font-bold text-red-600">{@presence_stats.absent}</p>
          <p class="text-xs text-slate-500">Alpha</p>
        </div>
      </div>
    </div>

    <%!-- Assign Mentor --%>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
      <h3 class="font-semibold text-slate-800 dark:text-slate-200 mb-3 flex items-center gap-2">
        <.icon name="hero-user-circle" class="w-5 h-5 text-blue-500" />
        Mentor Pembimbing
      </h3>
      <form phx-submit="assign_mentor" class="flex items-center gap-3">
        <select
          name="mentor_id"
          id="mentor-select"
          class="flex-1 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 text-slate-900 dark:text-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="">-- Belum ditentukan --</option>
          <%= for mentor <- @mentors do %>
            <option value={mentor.id} selected={to_string(mentor.id) == @selected_mentor_id}>
              {mentor.name} ({mentor.email})
            </option>
          <% end %>
        </select>
        <button type="submit" id="save-mentor-btn" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors whitespace-nowrap">
          Simpan Mentor
        </button>
      </form>
    </div>

    <%!-- Tabs --%>
    <div class="border-b border-slate-200 dark:border-slate-700">
      <nav class="flex gap-1 -mb-px">
        <button
          id="tab-logbook"
          phx-click="switch_tab"
          phx-value-tab="logbook"
          class={[
            "px-4 py-2.5 text-sm font-medium border-b-2 transition-colors",
            @active_tab == :logbook && "border-blue-600 text-blue-600",
            @active_tab != :logbook && "border-transparent text-slate-500 hover:text-slate-700 dark:text-slate-300"
          ]}
        >
          <.icon name="hero-book-open" class="w-4 h-4 inline mr-1" />
          Logbook
        </button>
        <button
          id="tab-presensi"
          phx-click="switch_tab"
          phx-value-tab="presensi"
          class={[
            "px-4 py-2.5 text-sm font-medium border-b-2 transition-colors",
            @active_tab == :presensi && "border-blue-600 text-blue-600",
            @active_tab != :presensi && "border-transparent text-slate-500 hover:text-slate-700 dark:text-slate-300"
          ]}
        >
          <.icon name="hero-calendar-days" class="w-4 h-4 inline mr-1" />
          Presensi
        </button>
        <button
          id="tab-complaints"
          phx-click="switch_tab"
          phx-value-tab="complaints"
          class={[
            "px-4 py-2.5 text-sm font-medium border-b-2 transition-colors",
            @active_tab == :complaints && "border-blue-600 text-blue-600",
            @active_tab != :complaints && "border-transparent text-slate-500 hover:text-slate-700 dark:text-slate-300"
          ]}
        >
          <.icon name="hero-chat-bubble-left-ellipsis" class="w-4 h-4 inline mr-1" />
          Keluhan
        </button>
      </nav>
    </div>

    <%!-- Tab: Logbook --%>
    <div class={if @active_tab != :logbook, do: "hidden"}>
      <div id="logbook-panel" phx-update="stream" class="space-y-3">
        <div id="empty-logs" class="hidden only:block text-center py-10 text-slate-500 text-sm">
          Belum ada weekly log.
        </div>
        <%= for {id, log} <- @streams.logs do %>
          <div id={id} class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
            <div class="flex items-center gap-2 mb-2">
              <span class="bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 text-xs font-bold px-2.5 py-0.5 rounded-full">
                Minggu ke-{log.week_number}
              </span>
              <span class="text-xs text-slate-400">
                {Calendar.strftime(log.week_start_date, "%d %b")} – {Calendar.strftime(log.week_end_date, "%d %b %Y")}
              </span>
            </div>
            <h4 class="font-semibold text-slate-900 dark:text-white">{log.activity_title}</h4>
            <%= if log.activity_description do %>
              <p class="text-sm text-slate-600 mt-1">{log.activity_description}</p>
            <% end %>
            <%= if log.feedback do %>
              <div class="mt-3 bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 rounded-xl p-3">
                <p class="text-xs font-semibold text-green-700 dark:text-green-400 mb-1">Feedback Mentor</p>
                <p class="text-sm text-green-800 dark:text-green-300">{log.feedback}</p>
              </div>
            <% else %>
              <p class="text-xs text-orange-500 mt-2 italic">Belum ada feedback dari mentor.</p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%!-- Tab: Presensi --%>
    <div class={if @active_tab != :presensi, do: "hidden"}>
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div id="presences-panel" phx-update="stream" class="divide-y divide-slate-100 dark:divide-slate-800">
          <div id="empty-presences" class="hidden only:block text-center py-10 text-slate-500 text-sm">
            Belum ada data presensi.
          </div>
          <%= for {id, presence} <- @streams.presences do %>
            <% {label, badge_class} = status_badge(presence.status) %>
            <div id={id} class="flex items-center justify-between px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <div>
                <p class="text-sm font-medium text-slate-900 dark:text-white">
                  {Calendar.strftime(presence.date, "%A, %d %b %Y")}
                </p>
                <%= if presence.notes do %>
                  <p class="text-xs text-slate-500">{presence.notes}</p>
                <% end %>
              </div>
              <div class="flex items-center gap-4">
                <p class="text-xs text-slate-500">
                  <%= if presence.check_in do %>
                    {Calendar.strftime(presence.check_in, "%H:%M")}
                  <% else %>
                    --:--
                  <% end %>
                  /
                  <%= if presence.check_out do %>
                    {Calendar.strftime(presence.check_out, "%H:%M")}
                  <% else %>
                    --:--
                  <% end %>
                </p>
                <span class={["text-xs font-semibold px-2.5 py-1 rounded-full", badge_class]}>
                  {label}
                </span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Tab: Keluhan --%>
    <div class={if @active_tab != :complaints, do: "hidden"}>
      <div id="complaints-panel" phx-update="stream" class="space-y-3">
        <div id="empty-complaints" class="hidden only:block text-center py-10 text-slate-500 text-sm">
          Tidak ada keluhan dari intern ini.
        </div>
        <%= for {id, complaint} <- @streams.complaints do %>
          <div id={id} class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2 flex-wrap">
                  <span class={["text-xs font-semibold px-2.5 py-0.5 rounded-full", category_color(complaint.category)]}>
                    {complaint.category}
                  </span>
                  <%= if complaint.is_resolved do %>
                    <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">
                      Resolved
                    </span>
                  <% else %>
                    <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400">
                      Pending
                    </span>
                  <% end %>
                  <span class="text-xs text-slate-400">
                    {Calendar.strftime(complaint.inserted_at, "%d %b %Y, %H:%M")}
                  </span>
                </div>
                <p class="text-sm text-slate-700 dark:text-slate-300">{complaint.content}</p>
              </div>
              <button
                id={"resolve-btn-#{complaint.id}"}
                phx-click="resolve_complaint"
                phx-value-id={complaint.id}
                class={[
                  "text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors whitespace-nowrap",
                  complaint.is_resolved && "border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/50",
                  !complaint.is_resolved && "border-green-300 dark:border-green-700 text-green-700 dark:text-green-400 bg-green-50 dark:bg-green-900/30 hover:bg-green-100 dark:hover:bg-green-900/50"
                ]}
              >
                <%= if complaint.is_resolved, do: "Buka kembali", else: "Tandai Selesai" %>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</.navbarAdmin>
