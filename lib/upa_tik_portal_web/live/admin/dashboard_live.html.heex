<.navbarAdmin current_user={@current_user} active_tab={:dashboard}>
  <Layouts.flash_group flash={@flash} />

  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 shadow-sm">
      <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Dashboard Admin</h1>
        <p class="text-slate-500 mt-1 text-sm"><%= Calendar.strftime(DateTime.utc_now(), "%d %B %Y") %></p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <%!-- Keluhan & Pengajuan --%>
      <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700 flex items-center hover:shadow-md transition-shadow">
        <div class="p-3 rounded-xl bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 mr-4">
          <.icon name="hero-exclamation-circle" class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wider">Keluhan Baru</p>
          <p class="text-2xl font-bold text-red-600 dark:text-red-400"><%= @keluhan_baru %></p>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700 flex items-center hover:shadow-md transition-shadow">
        <div class="p-3 rounded-xl bg-amber-50 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 mr-4">
          <.icon name="hero-clock" class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wider">Pengajuan Menunggu</p>
          <p class="text-2xl font-bold text-amber-600 dark:text-amber-400"><%= @pending %></p>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700 flex items-center hover:shadow-md transition-shadow">
        <div class="p-3 rounded-xl bg-green-50 dark:bg-green-900/30 text-green-600 dark:text-green-400 mr-4">
          <.icon name="hero-check-circle" class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wider">Pengajuan Disetujui</p>
          <p class="text-2xl font-bold text-green-600 dark:text-green-400"><%= @disetujui %></p>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700 flex items-center hover:shadow-md transition-shadow">
        <div class="p-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 mr-4">
          <.icon name="hero-document-text" class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wider">Total Pengajuan</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white"><%= @total %></p>
        </div>
      </div>

      <%!-- Rekrutmen & Magang --%>
      <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700 flex items-center hover:shadow-md transition-shadow">
        <div class="p-3 rounded-xl bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 mr-4">
          <.icon name="hero-briefcase" class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wider">Lowongan Aktif</p>
          <p class="text-2xl font-bold text-blue-600 dark:text-blue-400"><%= @total_openings %></p>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700 flex items-center hover:shadow-md transition-shadow">
        <div class="p-3 rounded-xl bg-orange-50 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 mr-4">
          <.icon name="hero-inbox-arrow-down" class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wider">Pelamar Menunggu</p>
          <p class="text-2xl font-bold text-orange-600 dark:text-orange-400"><%= @pending_participants %></p>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700 flex items-center hover:shadow-md transition-shadow">
        <div class="p-3 rounded-xl bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 mr-4">
          <.icon name="hero-users" class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wider">Intern Aktif</p>
          <p class="text-2xl font-bold text-indigo-600 dark:text-indigo-400"><%= @active_interns %></p>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700 flex items-center hover:shadow-md transition-shadow">
        <div class="p-3 rounded-xl bg-teal-50 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 mr-4">
          <.icon name="hero-calendar-days" class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wider">Presensi Hari Ini</p>
          <p class="text-2xl font-bold text-teal-600 dark:text-teal-400"><%= @presensi_hari_ini %></p>
        </div>
      </div>

      <%!-- Pengguna Umum --%>
      <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700 flex items-center hover:shadow-md transition-shadow col-span-1 sm:col-span-2 lg:col-span-4">
        <div class="p-3 rounded-xl bg-slate-800 dark:bg-slate-700 text-white mr-4">
          <.icon name="hero-identification" class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wider">Total Pengguna Terdaftar</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white"><%= @total_users %> <span class="text-sm font-medium text-slate-500">Akun terverifikasi</span></p>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-900 shadow-sm rounded-2xl p-6 md:p-8 border border-slate-200 dark:border-slate-700">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-6 border-b border-slate-100 pb-4">Akses Cepat Tautan Manajerial</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        
        <a href="/admin/pengajuan" class="group relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 shadow-sm hover:shadow-md hover:border-blue-300 transition-all flex flex-col items-start gap-4">
          <div class="bg-blue-50 dark:bg-blue-900/30 p-3 rounded-lg text-blue-600 dark:text-blue-400 group-hover:scale-110 transition-transform">
            <.icon name="hero-document-check" class="w-6 h-6" />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Validasi Pengajuan</p>
            <p class="text-xs font-medium text-slate-500 mt-1">Verifikasi akun dan KTM</p>
          </div>
        </a>

        <a href="/admin/keluhan" class="group relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 shadow-sm hover:shadow-md hover:border-red-300 transition-all flex flex-col items-start gap-4">
          <div class="bg-red-50 dark:bg-red-900/30 p-3 rounded-lg text-red-600 dark:text-red-400 group-hover:scale-110 transition-transform">
            <.icon name="hero-chat-bubble-left-right" class="w-6 h-6" />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Keluhan Teknis</p>
            <p class="text-xs font-medium text-slate-500 mt-1">Tindak lanjut masalah portal</p>
          </div>
        </a>

        <a href="/admin/lowongan" class="group relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 shadow-sm hover:shadow-md hover:border-blue-300 transition-all flex flex-col items-start gap-4">
          <div class="bg-blue-50 dark:bg-blue-900/30 p-3 rounded-lg text-blue-600 dark:text-blue-400 group-hover:scale-110 transition-transform">
            <.icon name="hero-briefcase" class="w-6 h-6" />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Lowongan Magang</p>
            <p class="text-xs font-medium text-slate-500 mt-1">Kelola pembukaan magang</p>
          </div>
        </a>

        <a href="/admin/pelamar" class="group relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 shadow-sm hover:shadow-md hover:border-orange-300 transition-all flex flex-col items-start gap-4">
          <div class="bg-orange-50 dark:bg-orange-900/30 p-3 rounded-lg text-orange-600 dark:text-orange-400 group-hover:scale-110 transition-transform">
            <.icon name="hero-inbox-arrow-down" class="w-6 h-6" />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Daftar Pelamar</p>
            <p class="text-xs font-medium text-slate-500 mt-1">Review pendaftar magang</p>
          </div>
        </a>

        <a href="/admin/intern" class="group relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition-all flex flex-col items-start gap-4">
          <div class="bg-indigo-50 dark:bg-indigo-900/30 p-3 rounded-lg text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform">
            <.icon name="hero-users" class="w-6 h-6" />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Intern Aktif</p>
            <p class="text-xs font-medium text-slate-500 mt-1">Kelola data peserta magang</p>
          </div>
        </a>

        <a href="/admin/presensi" class="group relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 shadow-sm hover:shadow-md hover:border-teal-300 transition-all flex flex-col items-start gap-4">
          <div class="bg-teal-50 dark:bg-teal-900/30 p-3 rounded-lg text-teal-600 dark:text-teal-400 group-hover:scale-110 transition-transform">
            <.icon name="hero-calendar-days" class="w-6 h-6" />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Data Presensi</p>
            <p class="text-xs font-medium text-slate-500 mt-1">Rekap kehadiran harian</p>
          </div>
        </a>

        <a href="/admin/users" class="group relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 shadow-sm hover:shadow-md hover:border-slate-400 transition-all flex flex-col items-start gap-4">
          <div class="bg-slate-100 dark:bg-slate-800 p-3 rounded-lg text-slate-700 dark:text-slate-300 group-hover:scale-110 transition-transform">
            <.icon name="hero-identification" class="w-6 h-6" />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Daftar Pengguna</p>
            <p class="text-xs font-medium text-slate-500 mt-1">Kelola peran & hak akses</p>
          </div>
        </a>

      </div>
    </div>

  </div>
</.navbarAdmin>
