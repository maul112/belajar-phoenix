<.navbarAdmin current_user={@current_user} active_tab={:users}>
  <Layouts.flash_group flash={@flash} />
  
  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 shadow-sm">
      <div class="text-center md:text-left">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Basis Pengguna</h1>
        <p class="text-slate-500 mt-1 text-sm">Kelola Otoritas dan Akses Sistem</p>
      </div>
      <div class="flex items-center gap-4 mt-4 md:mt-0">
        <div class="flex flex-col items-center px-4 py-2 bg-blue-50 rounded-xl border border-blue-100">
          <span class="text-xs font-semibold text-blue-600">Total Terdaftar</span>
          <span class="text-xl font-bold text-blue-700"><%= length(@users) %> User</span>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead class="bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
            <tr>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Identitas Pengguna</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Kredensial Email</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">Hak Akses</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Aksi & Aktivitas</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <%= for user <- @users do %>
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-slate-800 text-white rounded-full flex items-center justify-center font-bold text-lg hover:bg-blue-600 transition-colors cursor-default">
                      <%= String.at(user.name, 0) %>
                    </div>
                    <div>
                      <p class="font-bold text-slate-900 dark:text-white text-sm hover:text-blue-600 transition-colors cursor-default"><%= user.name %></p>
                      <p class="text-xs text-slate-500 mt-0.5">ID: #<%= user.id %></p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <span class="inline-block text-sm font-medium text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-800 px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-700">
                    <%= user.email %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class={["px-3 py-1 rounded-full text-xs font-semibold", role_class(user.role)]}>
                    <%= String.capitalize(user.role) %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex flex-col items-end gap-2">
                    <div class="flex gap-2">
                      <%= if user.role != "mentor" do %>
                        <button phx-click="change_role" phx-value-id={user.id} phx-value-role="mentor" data-confirm="Ubah role user ini menjadi Mentor?" class="px-3 py-1.5 bg-white dark:bg-slate-900 border border-green-300 text-green-700 rounded-lg hover:bg-green-50 transition-colors text-xs font-semibold">
                          Jadikan Mentor
                        </button>
                      <% end %>
                      <%= if user.role == "mentor" do %>
                        <button phx-click="change_role" phx-value-id={user.id} phx-value-role="mahasiswa" data-confirm="Kembalikan role user ini menjadi Mahasiswa?" class="px-3 py-1.5 bg-white dark:bg-slate-900 border border-red-300 text-red-600 rounded-lg hover:bg-red-50 transition-colors text-xs font-semibold">
                          Hapus Mentor
                        </button>
                      <% end %>
                    </div>
                    <div>
                      <p class="text-[10px] text-slate-400 font-semibold mb-0.5">Update Terakhir</p>
                      <p class="text-xs font-medium text-slate-600"><%= Calendar.strftime(user.updated_at, "%d %b %Y") %></p>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</.navbarAdmin>
