<.navbar active_tab={:keluhan} current_user={@current_user}>
  <Layouts.flash_group flash={@flash} />
  
  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <.heading_page
      heading_text_primary="Lapor"
      heading_text_secondary="Kendala"
      sub_heading_text="Sampaikan masalah teknis Anda secara detail agar tim kami dapat membantu dengan cepat."
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start mt-8">
      <div class="lg:col-span-1">
        <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
          <div class="mb-6">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">Input Laporan</h2>
            <p class="text-slate-500 text-sm mt-1">Lengkapi form di bawah untuk mengirim tiket laporan.</p>
          </div>

          <%= if @submitted do %>
            <div class="bg-blue-50 p-6 rounded-xl border border-blue-100 text-center">
              <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
                <.icon name="hero-check" class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-blue-900 mb-2">Terkirim!</h3>
              <button phx-click="new_keluhan" class="text-blue-600 font-semibold text-sm hover:underline mt-2">Ketik Laporan Lain</button>
            </div>
          <% else %>
            <form phx-submit="submit" phx-change="update_field" class="space-y-5">
              <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Subjek Masalah</label>
                <input type="text" name="subject" value={@subject} placeholder="Contoh: Akun Terkunci" required
                  class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white dark:bg-slate-900 outline-none transition-colors text-sm text-slate-900 dark:text-white"/>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Detail Kronologi</label>
                <textarea name="description" rows="5" placeholder="Jelaskan masalah secara detail..." required
                  class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white dark:bg-slate-900 outline-none resize-none transition-colors text-sm text-slate-900 dark:text-white"><%= @description %></textarea>
              </div>
              <button type="submit" class="w-full py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors flex items-center justify-center gap-2 text-sm">
                <span>Kirim Sekarang</span>
                <.icon name="hero-paper-airplane" class="w-4 h-4" />
              </button>
            </form>
          <% end %>
        </div>
      </div>

      <div class="lg:col-span-2">
        <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">Riwayat Keluhan</h2>
            <div class="px-3 py-1 bg-slate-100 rounded-full text-xs font-semibold text-slate-600">
              Total: <%= Enum.count(@keluhans) %>
            </div>
          </div>

          <div class="space-y-6">
            <%= if Enum.empty?(@keluhans) do %>
              <div class="py-12 text-center rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-700">
                <.icon name="hero-inbox" class="mx-auto h-12 w-12 text-slate-300" />
                <p class="mt-4 text-sm font-medium text-slate-500">Data belum tersedia</p>
              </div>
            <% else %>
              <%= for keluhan <- @keluhans do %>
                <% {badge_class, badge_text} = status_badge(keluhan.status) %>
                <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-700 hover:shadow-md transition-shadow">
                  <div class="flex justify-between items-start mb-4">
                    <span class={"inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium #{badge_class}"}>
                      <%= badge_text %>
                    </span>
                    <span class="text-xs text-slate-500"><%= Calendar.strftime(keluhan.inserted_at, "%d %b %Y") %></span>
                  </div>
                  <h4 class="font-bold text-slate-900 dark:text-white text-lg mb-2"><%= keluhan.subject %></h4>
                  <p class="text-sm text-slate-600 leading-relaxed"><%= keluhan.description %></p>

                  <div class="mt-6 pt-6 border-t border-slate-100">
                    <h5 class="text-xs font-semibold text-slate-500 mb-4">Riwayat Percakapan:</h5>
                    <div class="space-y-4 mb-4 max-h-[300px] overflow-y-auto pr-2 custom-scrollbar">
                      <%= if Enum.empty?(keluhan.messages) do %>
                        <p class="text-xs text-slate-400 italic">Belum ada percakapan.</p>
                      <% else %>
                        <%= for msg <- keluhan.messages do %>
                          <div class={["flex", if(msg.is_admin, do: "justify-start", else: "justify-end")]}>
                            <div class={["max-w-[85%] rounded-2xl p-3", if(msg.is_admin, do: "bg-slate-100 text-slate-800 dark:text-slate-200 rounded-tl-sm", else: "bg-blue-600 text-white rounded-tr-sm")]}>
                              <p class="text-[10px] mb-1 font-semibold opacity-70"><%= if msg.is_admin, do: "Admin UPA TIK", else: "Anda" %></p>
                              <p class="text-sm"><%= msg.content %></p>
                              <p class="text-[9px] text-right mt-1 opacity-60"><%= Calendar.strftime(msg.inserted_at, "%d %b %Y %H:%M") %></p>
                            </div>
                          </div>
                        <% end %>
                      <% end %>
                    </div>

                    <form phx-submit="send_message" phx-change="update_message" class="flex gap-2">
                      <input type="hidden" name="keluhan_id" value={keluhan.id} />
                      <input type="text" name={"message_" <> keluhan.id} value={@new_messages[keluhan.id] || ""} placeholder="Ketik balasan untuk Admin..." autocomplete="off"
                             class="flex-1 px-4 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" />
                      <button type="submit" class="px-4 py-2 bg-slate-900 text-white rounded-lg text-sm font-semibold hover:bg-slate-800 transition-colors">Kirim</button>
                    </form>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</.navbar>
