<.navbar active_tab={:status} current_user={@current_user}>
  <Layouts.flash_group flash={@flash} />
  
  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
      <div class="text-center md:text-left">
        <h1 class="text-2xl font-bold text-slate-900">Monitor Layanan</h1>
        <p class="text-slate-500 mt-1 text-sm">Riwayat pengajuan untuk <span class="font-bold text-blue-600"><%= @current_user.name %></span></p>
      </div>
      <a href="/portal/ajukan" class="mt-4 md:mt-0 px-6 py-3 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700 transition-colors text-sm flex items-center gap-2">
        <.icon name="hero-plus" class="w-4 h-4" />
        <span>Buat Baru</span>
      </a>
    </div>

    <section class="space-y-6 mb-12">
      <h2 class="text-lg font-bold text-slate-900 border-b border-slate-200 pb-2">Riwayat Aktivasi & Reset</h2>

      <%= if Enum.empty?(@requests) do %>
        <div class="bg-white rounded-2xl p-12 text-center border-2 border-dashed border-slate-200 shadow-sm">
          <.icon name="hero-document-text" class="mx-auto h-12 w-12 text-slate-300" />
          <p class="mt-4 text-sm font-medium text-slate-500">Belum ada pengajuan</p>
        </div>
      <% else %>
        <div class="grid grid-cols-1 gap-4">
          <%= for request <- @requests do %>
            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex flex-col md:flex-row justify-between gap-6">
                <div class="space-y-4 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class={"px-3 py-1 rounded-full text-xs font-semibold #{status_class(request.status)}"}>
                      <%= status_label(request.status) %>
                    </span>
                    <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1 rounded-full">
                      <%= format_type(request.request_type) %>
                    </span>
                  </div>

                  <div>
                    <h3 class="text-lg font-bold text-slate-900"><%= request.full_name %></h3>
                    <p class="text-sm font-medium text-slate-600 mt-1"><%= request.email_requested %></p>
                  </div>

                  <%= if request.status == "disetujui" && request.otp_code do %>
                    <div class="mt-4 p-4 bg-blue-50 border border-blue-100 rounded-xl">
                      <p class="text-xs font-bold text-blue-800 mb-1">Pemberitahuan</p>
                      <p class="text-sm font-semibold text-blue-900">Kredensial Terkirim!</p>
                      <p class="text-xs text-blue-600 mt-1">Silakan cek kotak masuk Gmail Anda untuk melihat kode akses.</p>
                    </div>
                  <% end %>

                  <%= if request.admin_notes do %>
                    <div class="mt-4 p-4 bg-slate-50 rounded-xl border border-slate-200">
                      <p class="text-xs font-bold text-slate-700 mb-1">Catatan dari Admin</p>
                      <p class="text-sm text-slate-600 italic">"<%= request.admin_notes %>"</p>
                    </div>
                  <% end %>
                </div>

                <div class="md:text-right flex flex-col justify-between">
                  <div>
                    <p class="text-xs font-semibold text-slate-500">Waktu Pengajuan</p>
                    <p class="text-sm font-bold text-slate-900 mt-1"><%= Calendar.strftime(request.inserted_at, "%d %b %Y") %></p>
                    <p class="text-xs text-slate-500"><%= Calendar.strftime(request.inserted_at, "%H:%M WIB") %></p>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="space-y-6">
      <h2 class="text-lg font-bold text-slate-900 border-b border-slate-200 pb-2">Status Keluhan</h2>

      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-base font-bold text-slate-900">Riwayat Laporan</h3>
          <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1 rounded-full"><%= Enum.count(@keluhans) %> Laporan</span>
        </div>

        <div class="space-y-4 max-h-[500px] overflow-y-auto pr-2 custom-scrollbar">
          <%= if Enum.empty?(@keluhans) do %>
            <div class="p-12 text-center border-2 border-dashed border-slate-200 rounded-xl">
              <p class="text-sm font-medium text-slate-500">Belum ada data keluhan</p>
            </div>
          <% else %>
            <%= for keluhan <- @keluhans do %>
              <% {badge_class, badge_text} = keluhan_badge(keluhan.status) %>
              <div class="bg-white p-5 rounded-xl border border-slate-200 hover:border-blue-300 transition-colors flex flex-col md:flex-row justify-between gap-4">
                <div class="flex-1">
                  <h4 class="font-bold text-slate-900 text-base"><%= keluhan.subject %></h4>
                  <p class="text-slate-600 text-sm mt-1 line-clamp-2"><%= keluhan.description %></p>
                </div>
                <div class="flex flex-col items-start md:items-end justify-between gap-2">
                  <span class={"text-xs font-semibold px-3 py-1 rounded-full #{badge_class}"}>
                    <%= badge_text %>
                  </span>
                  <div class="text-right mt-2">
                    <span class="block text-xs font-medium text-slate-500 mb-1"><%= Calendar.strftime(keluhan.inserted_at, "%d %b %Y") %></span>
                    <a href="/portal/keluhan" class="text-xs font-semibold text-blue-600 hover:text-blue-700 hover:underline">Lihat Detail &rarr;</a>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  </div>
</.navbar>
