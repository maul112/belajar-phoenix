<.navbar active_tab={:magang} current_user={@current_user}>
  <Layouts.flash_group flash={@flash} />

  <div class="max-w-7xl mx-auto px-4 py-8 space-y-6">
    <.link navigate={~p"/portal/magang"} class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-blue-600 transition-colors">
      <.icon name="hero-arrow-left" class="w-4 h-4" />
      Kembali ke Magang Saya
    </.link>

    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Keluhan Magang</h1>
        <p class="text-slate-500 text-sm mt-1">Sampaikan kendala yang kamu temui selama magang</p>
      </div>
      <%= if not @is_completed do %>
        <button
          id="toggle-complaint-form"
          phx-click="toggle_form"
          class={[
            "inline-flex items-center gap-2 font-semibold text-sm px-4 py-2.5 rounded-xl transition-colors",
            @show_form && "bg-slate-200 text-slate-700 dark:text-slate-300 hover:bg-slate-300",
            !@show_form && "bg-blue-600 text-white hover:bg-blue-700"
          ]}
        >
          <%= if @show_form do %>
            <.icon name="hero-x-mark" class="w-4 h-4" />
            Tutup
          <% else %>
            <.icon name="hero-plus" class="w-4 h-4" />
            Kirim Keluhan
          <% end %>
        </button>
      <% end %>
    </div>

    <%!-- Form Kirim Keluhan --%>
    <%= if not @is_completed and @show_form do %>
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-blue-200 p-6 shadow-sm">
        <h3 class="font-semibold text-slate-900 dark:text-white mb-1">Form Keluhan Baru</h3>
        <p class="text-xs text-orange-600 mb-4 bg-orange-50 p-2 rounded-lg border border-orange-100 flex items-center gap-2">
          <.icon name="hero-exclamation-triangle" class="w-4 h-4 flex-shrink-0" />
          Setiap pelamar hanya dapat mengirim maksimal 1 keluhan untuk setiap kategori.
        </p>
        <.form for={@form} id="complaint-form" phx-change="validate" phx-submit="submit" class="space-y-4">

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Kategori</label>
            <select
              id={@form[:category].id}
              name={@form[:category].name}
              class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
              <option value="">-- Pilih Kategori --</option>
              <%= Phoenix.HTML.Form.options_for_select(["Fasilitas", "Teknis", "Lingkungan", "Lainnya"], @form[:category].value) %>
            </select>
            <%= if @form[:category].errors != [] do %>
              <p class="text-xs text-red-600 mt-1">
                {hd(@form[:category].errors) |> elem(0)}
              </p>
            <% end %>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Isi Keluhan</label>
            <textarea
              id={@form[:content].id}
              name={@form[:content].name}
              rows="4"
              placeholder="Ceritakan kendala atau masukan kamu secara detail..."
              class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"
            >{Phoenix.HTML.Form.normalize_value("textarea", @form[:content].value)}</textarea>
            <%= if @form[:content].errors != [] do %>
              <p class="text-xs text-red-600 mt-1">
                {hd(@form[:content].errors) |> elem(0)}
              </p>
            <% end %>
          </div>

          <div class="flex justify-end gap-3">
            <button type="button" id="cancel-complaint" phx-click="toggle_form" class="px-4 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 rounded-xl transition-colors">
              Batal
            </button>
            <button type="submit" id="submit-complaint" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-5 py-2.5 rounded-xl transition-colors">
              Kirim Keluhan
            </button>
          </div>
        </.form>
      </div>
    <% end %>

    <%!-- Daftar Keluhan --%>
    <div id="complaints-list" phx-update="stream" class="space-y-3">
      <div class="hidden only:flex only:flex-col only:items-center only:py-16 only:text-center">
        <div class="w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center mb-3">
          <.icon name="hero-chat-bubble-left-ellipsis" class="w-7 h-7 text-slate-400" />
        </div>
        <p class="font-semibold text-slate-700 dark:text-slate-300">Belum ada keluhan</p>
        <p class="text-sm text-slate-500">Semua berjalan lancar? Bagus! 🎉</p>
      </div>

      <%= for {id, complaint} <- @streams.complaints do %>
        <div id={id} class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-2">
                <span class={["text-xs font-semibold px-2.5 py-0.5 rounded-full", category_color(complaint.category)]}>
                  {complaint.category}
                </span>
                <%= if complaint.is_resolved do %>
                  <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-green-100 text-green-700 flex items-center gap-1">
                    <.icon name="hero-check-circle" class="w-3 h-3" />
                    Resolved
                  </span>
                <% else %>
                  <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-orange-100 text-orange-700">
                    Pending
                  </span>
                <% end %>
              </div>
              <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">{complaint.content}</p>
              <p class="text-xs text-slate-400 mt-2">
                {Calendar.strftime(complaint.inserted_at, "%d %b %Y, %H:%M")}
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</.navbar>
