<.navbar active_tab={:magang} current_user={@current_user}>
  <Layouts.flash_group flash={@flash} />

  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8">

    <%!-- Header --%>
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Magang Saya</h1>
        <p class="text-slate-500 text-sm mt-1">Kelola aktivitas magang kamu di sini</p>
      </div>
    </div>

    <%= if @has_active_internship do %>
      <%!-- INTERN AKTIF: tampilkan dashboard --%>

      <%!-- Info Card Partisipasi --%>
      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl p-6 text-white shadow-lg">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-blue-100 text-sm font-medium">Posisi Magang</p>
            <h2 class="text-xl font-bold mt-1">{@participation.internship_opening.title}</h2>
            <p class="text-blue-100 text-sm mt-1">{@participation.internship_opening.department}</p>
          </div>
          <span class="bg-white/20 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1 rounded-full border border-white/30">
            Aktif
          </span>
        </div>

        <div class="mt-4 pt-4 border-t border-white/20 grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div>
            <p class="text-blue-200 text-xs">Mulai</p>
            <p class="font-semibold text-sm">{Calendar.strftime(@participation.start_date, "%d %b %Y")}</p>
          </div>
          <div>
            <p class="text-blue-200 text-xs">Selesai</p>
            <p class="font-semibold text-sm">{Calendar.strftime(@participation.end_date, "%d %b %Y")}</p>
          </div>
          <div>
            <p class="text-blue-200 text-xs">Universitas</p>
            <p class="font-semibold text-sm">{@participation.university}</p>
          </div>
          <div>
            <p class="text-blue-200 text-xs">Mentor</p>
            <p class="font-semibold text-sm">
              <%= if @participation.mentor do %>
                {@participation.mentor.name}
              <% else %>
                Belum ditentukan
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <%!-- Check-in / Check-out Card --%>
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <h3 class="font-semibold text-slate-900 mb-4 flex items-center gap-2">
          <.icon name="hero-clock" class="w-5 h-5 text-blue-500" />
          Presensi Hari Ini
        </h3>

        <%= if @today_presence do %>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-6">
              <div class="text-center">
                <p class="text-xs text-slate-500">Check-in</p>
                <p class="font-bold text-slate-900 text-lg">
                  <%= if @today_presence.check_in do %>
                    {Calendar.strftime(@today_presence.check_in, "%H:%M")}
                  <% else %>
                    --:--
                  <% end %>
                </p>
              </div>
              <div class="w-8 h-px bg-slate-300"></div>
              <div class="text-center">
                <p class="text-xs text-slate-500">Check-out</p>
                <p class="font-bold text-slate-900 text-lg">
                  <%= if @today_presence.check_out do %>
                    {Calendar.strftime(@today_presence.check_out, "%H:%M")}
                  <% else %>
                    --:--
                  <% end %>
                </p>
              </div>
            </div>

            <%= if is_nil(@today_presence.check_out) do %>
              <button
                phx-click={show_modal("qr-modal")}
                class="bg-slate-900 hover:bg-slate-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors flex items-center gap-2"
              >
                <.icon name="hero-qr-code" class="w-5 h-5" />
                Tampilkan QR
              </button>
            <% else %>
              <span class="text-green-600 font-semibold text-sm flex items-center gap-1">
                <.icon name="hero-check-circle" class="w-5 h-5" />
                Selesai hari ini
              </span>
            <% end %>
          </div>
        <% else %>
          <div class="flex items-center justify-between">
            <p class="text-slate-500 text-sm">Kamu belum check-in hari ini.</p>
            <button
              phx-click={show_modal("qr-modal")}
              class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors flex items-center gap-2"
            >
              <.icon name="hero-qr-code" class="w-5 h-5" />
              Tampilkan QR
            </button>
          </div>
        <% end %>
      </div>

      <.modal id="qr-modal">
        <div class="text-center p-2">
          <h3 class="text-xl font-bold text-slate-900 mb-2">QR Code Presensi</h3>
          <p class="text-sm text-slate-500 mb-6">Arahkan layar ini ke Scanner QR Mentor atau Admin untuk melakukan Check-in dan Check-out.</p>
          <div class="bg-white p-6 border-2 border-slate-100 rounded-2xl max-w-[280px] w-full mx-auto shadow-sm flex items-center justify-center overflow-hidden">
            <div class="w-full h-auto max-w-full [&>svg]:w-full [&>svg]:h-auto">
              <%= raw(@qr_svg) %>
            </div>
          </div>
        </div>
      </.modal>

      <%!-- Stats Grid --%>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <%!-- Presensi --%>
        <.link navigate={~p"/portal/magang/presensi"} class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md hover:border-blue-300 transition-all group">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-green-100 flex items-center justify-center">
              <.icon name="hero-calendar-days" class="w-5 h-5 text-green-600" />
            </div>
            <.icon name="hero-arrow-right" class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors" />
          </div>
          <p class="text-2xl font-bold text-slate-900">{@presence_stats.present}</p>
          <p class="text-sm text-slate-500">Hari Hadir</p>
          <p class="text-xs text-slate-400 mt-1">{@presence_stats.total} total presensi tercatat</p>
        </.link>

        <%!-- Logbook --%>
        <.link navigate={~p"/portal/magang/logbook"} class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md hover:border-blue-300 transition-all group">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center">
              <.icon name="hero-book-open" class="w-5 h-5 text-blue-600" />
            </div>
            <.icon name="hero-arrow-right" class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors" />
          </div>
          <p class="text-2xl font-bold text-slate-900">{@log_stats.total}</p>
          <p class="text-sm text-slate-500">Weekly Log</p>
          <p class="text-xs text-slate-400 mt-1">{@log_stats.with_feedback} sudah dapat feedback</p>
        </.link>

        <%!-- Complaint --%>
        <.link navigate={~p"/portal/magang/complaint"} class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md hover:border-blue-300 transition-all group">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center">
              <.icon name="hero-chat-bubble-left-ellipsis" class="w-5 h-5 text-orange-600" />
            </div>
            <.icon name="hero-arrow-right" class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors" />
          </div>
          <p class="text-2xl font-bold text-slate-900">{@complaint_stats.pending}</p>
          <p class="text-sm text-slate-500">Keluhan Pending</p>
          <p class="text-xs text-slate-400 mt-1">{@complaint_stats.total} total keluhan dikirim</p>
        </.link>
      </div>

    <% else %>
      <%!-- TIDAK ADA MAGANG AKTIF --%>
      <div class="bg-white rounded-2xl border border-slate-200 p-10 text-center">
        <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4">
          <.icon name="hero-briefcase" class="w-8 h-8 text-slate-400" />
        </div>
        <h3 class="text-lg font-semibold text-slate-900">Belum Ada Magang Aktif</h3>
        <p class="text-slate-500 text-sm mt-2 max-w-sm mx-auto">
          Kamu belum memiliki magang yang berstatus diterima. Ajukan lamaran terlebih dahulu.
        </p>
        <.link navigate={~p"/portal/lowongan"} class="inline-flex items-center gap-2 mt-6 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-5 py-2.5 rounded-xl transition-colors">
          <.icon name="hero-briefcase" class="w-4 h-4" />
          Lihat Lowongan
        </.link>

        <%!-- Riwayat lamaran jika ada --%>
        <%= if length(@participations) > 0 or @search != "" or @status != "" do %>
          <div class="mt-8 text-left">
            <h4 class="font-semibold text-slate-700 text-sm mb-3">Riwayat Lamaran Kamu</h4>
            
            <form phx-change="filter" class="w-full flex flex-col sm:flex-row gap-3 mb-4">
              <div class="relative w-full sm:w-2/3">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <.icon name="hero-magnifying-glass" class="h-4 w-4 text-slate-400" />
                </div>
                <input type="text" name="search" value={@search} phx-debounce="300" placeholder="Cari nama lowongan..." class="block w-full pl-9 pr-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500" />
              </div>
              <div class="w-full sm:w-1/3">
                <select name="status" class="block w-full py-2 px-3 border border-slate-300 bg-white rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500">
                  <option value="">Semua Status</option>
                  <option value="applied" selected={@status == "applied"}>Applied</option>
                  <option value="interview" selected={@status == "interview"}>Interview</option>
                  <option value="rejected" selected={@status == "rejected"}>Rejected</option>
                </select>
              </div>
            </form>

            <div class="space-y-2">
              <%= for p <- @participations do %>
                <div class="flex items-center justify-between bg-slate-50 rounded-xl px-4 py-3 border border-slate-200">
                  <div>
                    <p class="text-sm font-medium text-slate-900">{p.internship_opening.title}</p>
                    <p class="text-xs text-slate-500">{p.internship_opening.department}</p>
                  </div>
                  <span class={["text-xs font-semibold px-2.5 py-1 rounded-full", status_color(p.status)]}>
                    {status_label(p.status)}
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>
</.navbar>
