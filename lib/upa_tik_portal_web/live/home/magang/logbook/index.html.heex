<.navbar active_tab={:magang} current_user={@current_user}>
  <Layouts.flash_group flash={@flash} />

  <div class="max-w-7xl mx-auto px-4 py-8 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Logbook Mingguan</h1>
        <p class="text-slate-500 text-sm mt-1">Rekap kegiatan magang tiap minggunya</p>
      </div>
      <%= if is_nil(@participation.end_date) or Date.compare(UpaTikPortalWeb.Helpers.TimeHelper.today_wib(), @participation.end_date) != :gt do %>
        <.link
          navigate={~p"/portal/magang/logbook/new"}
          class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-4 py-2.5 rounded-xl transition-colors"
        >
          <.icon name="hero-plus" class="w-4 h-4" />
          Tambah Log
        </.link>
      <% end %>
    </div>

    <%!-- Back link --%>
    <.link navigate={~p"/portal/magang"} class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-blue-600 transition-colors">
      <.icon name="hero-arrow-left" class="w-4 h-4" />
      Kembali ke Magang Saya
    </.link>

    <%!-- List logs --%>
    <div id="logs-list" phx-update="stream" class="space-y-4">
      <div class="hidden only:flex only:flex-col only:items-center only:justify-center only:py-16 only:text-center">
        <div class="w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center mb-3">
          <.icon name="hero-book-open" class="w-7 h-7 text-slate-400" />
        </div>
        <p class="font-semibold text-slate-700">Belum ada logbook</p>
        <p class="text-sm text-slate-500">Mulai catat kegiatan mingguan kamu</p>
      </div>

      <%= for {id, log} <- @streams.logs do %>
        <div id={id} class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="bg-blue-100 text-blue-700 text-xs font-bold px-2.5 py-0.5 rounded-full">
                  Minggu ke-{log.week_number}
                </span>
                <% {label, badge_class} = feedback_badge(log.feedback) %>
                <span class={["text-xs font-medium px-2.5 py-0.5 rounded-full", badge_class]}>
                  {label}
                </span>
              </div>
              <h3 class="font-semibold text-slate-900 text-base truncate">{log.activity_title}</h3>
              <p class="text-xs text-slate-500 mt-1">
                {Calendar.strftime(log.week_start_date, "%d %b")} – {Calendar.strftime(log.week_end_date, "%d %b %Y")}
              </p>
              <%= if log.activity_description do %>
                <p class="text-sm text-slate-600 mt-2 line-clamp-2">{log.activity_description}</p>
              <% end %>
              <%= if log.feedback do %>
                <div class="mt-3 bg-green-50 border border-green-200 rounded-xl p-3">
                  <p class="text-xs font-semibold text-green-700 mb-1 flex items-center gap-1">
                    <.icon name="hero-chat-bubble-left-right" class="w-3.5 h-3.5" />
                    Feedback Mentor
                  </p>
                  <p class="text-sm text-green-800">{log.feedback}</p>
                </div>
              <% end %>
              <div class="mt-4 flex items-center gap-3">
                <%= if log.pdf_url do %>
                  <a href={log.pdf_url} target="_blank" class="inline-flex items-center gap-1.5 text-xs font-medium text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-lg transition-colors">
                    <.icon name="hero-document-text" class="w-4 h-4" />
                    Lihat Laporan
                  </a>
                <% end %>
                <button
                  phx-click="delete"
                  phx-value-id={log.id}
                  data-confirm="Apakah Anda yakin ingin menghapus log ini?"
                  class="inline-flex items-center gap-1.5 text-xs font-medium text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg transition-colors"
                >
                  <.icon name="hero-trash" class="w-4 h-4" />
                  Hapus
                </button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</.navbar>
