<.navbar active_tab={:home} current_user={@user}>
  <Layouts.flash_group flash={@flash} />
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-16">
    <!-- Decorative Background Mesh -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 -left-4 w-72 h-72 bg-blue-300 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>
      <div class="absolute top-0 -right-4 w-72 h-72 bg-indigo-300 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000"></div>
      <div class="absolute -bottom-8 left-20 w-72 h-72 bg-purple-300 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-4000"></div>
    </div>

    <div class="w-full relative z-10 px-6 lg:px-12">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        
        <!-- Left Content -->
        <div class="w-full lg:w-1/2 space-y-8 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 rounded-full bg-blue-50/80 backdrop-blur-sm px-4 py-1.5 text-sm font-semibold text-blue-700 ring-1 ring-inset ring-blue-700/10 shadow-sm transition-transform hover:scale-105 cursor-default">
            <span class="flex h-2 w-2 rounded-full bg-blue-600"></span>
            Penerimaan Magang 2026/2027 Dibuka
          </div>
      
          <div class="space-y-6">
            <h1 class="text-5xl font-extrabold tracking-tight sm:text-7xl text-slate-900 dark:text-white leading-tight">
              Kembangkan Karir Bersama <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">UPA TIK UTM</span>
            </h1>
            <p class="text-lg text-slate-600 leading-relaxed max-w-7xl mx-auto lg:mx-0">
              Platform terpadu untuk mengelola kegiatan magang Anda. Temukan lowongan, pantau status pengajuan, dan laporkan kegiatan harian Anda dengan mudah dalam satu portal digital.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
            <.link navigate={~p"/portal/lowongan"} class="w-full sm:w-auto rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-4 text-center text-sm font-semibold text-white shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300">
              Mulai Jelajahi Lowongan
            </.link>
            <.link navigate={~p"/portal/magang"} class="w-full sm:w-auto rounded-xl bg-white dark:bg-slate-900 px-8 py-4 text-center text-sm font-semibold text-slate-700 dark:text-slate-300 shadow-sm ring-1 ring-inset ring-slate-200 dark:ring-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-2">
              Buka Magang Saya <.icon name="hero-arrow-right" class="w-4 h-4" />
            </.link>
          </div>
        </div>

        <!-- Right Content: Floating Card & Logo -->
        <div class="w-full lg:w-1/2 relative hidden lg:block perspective-1000">
          <div class="relative w-full max-w-lg mx-auto transition-transform duration-700 hover:rotate-y-6 hover:rotate-x-6 hover:scale-105">
            <!-- Glassmorphism Card Behind Logo -->
            <div class="absolute inset-0 bg-white/40 dark:bg-slate-900/40 backdrop-blur-3xl rounded-3xl border border-white/50 dark:border-slate-700/50 shadow-2xl transform rotate-3"></div>
            <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 to-indigo-50/50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-3xl transform -rotate-3"></div>
            
            <div class="relative p-12 flex flex-col items-center justify-center bg-white/60 dark:bg-slate-900/60 backdrop-blur-xl rounded-3xl border border-white dark:border-slate-700 shadow-xl">
              <img 
                  class="w-48 h-auto drop-shadow-2xl animate-float" 
                  src="https://upload.wikimedia.org/wikipedia/commons/f/f1/UTM_DIKBUDRISTEK.png" 
                  alt="Logo UTM"
              >
              <div class="mt-8 grid grid-cols-2 gap-4 w-full">
                <div class="bg-white/80 dark:bg-slate-800/80 p-4 rounded-2xl shadow-sm text-center">
                  <p class="text-3xl font-black text-blue-600 dark:text-blue-400">12+</p>
                  <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-1">Divisi/Proyek</p>
                </div>
                <div class="bg-white/80 dark:bg-slate-800/80 p-4 rounded-2xl shadow-sm text-center">
                  <p class="text-3xl font-black text-indigo-600 dark:text-indigo-400">500+</p>
                  <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-1">Alumni Magang</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported By -->
  <section class="border-y border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 py-10">
    <div class="w-full px-6 text-center">
      <p class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-6">Dikembangkan dan Didukung Oleh</p>
      <div class="flex flex-wrap justify-center items-center gap-12 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
        <h3 class="text-xl font-bold text-slate-800 dark:text-slate-200">Universitas Trunojoyo Madura</h3>
        <h3 class="text-xl font-bold text-slate-800 dark:text-slate-200">UPA TIK</h3>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16 bg-white dark:bg-slate-900">
    <div class="w-full px-6 lg:px-12">
      <div class="text-center max-w-7xl mx-auto mb-20">
        <h2 class="text-sm font-bold text-blue-600 uppercase tracking-wider mb-2">Keunggulan</h2>
        <h3 class="text-3xl font-extrabold text-slate-900 dark:text-white sm:text-4xl">Sistem Terintegrasi untuk Kemudahan Magang</h3>
        <p class="mt-4 text-lg text-slate-600">Semua proses dari pendaftaran hingga penilaian akhir dilakukan secara digital dan transparan.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-10">
        <!-- Feature 1 -->
        <div class="group relative bg-white dark:bg-slate-900 p-8 rounded-3xl shadow-sm ring-1 ring-slate-200 dark:ring-slate-700 hover:shadow-2xl hover:ring-blue-600/50 dark:hover:ring-blue-500/50 transition-all duration-300 hover:-translate-y-2">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 to-transparent dark:from-blue-900/10 dark:to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-blue-100 to-blue-50 dark:from-blue-900/30 dark:to-blue-800/30 text-blue-600 dark:text-blue-400 rounded-2xl flex items-center justify-center mb-6 shadow-inner">
              <.icon name="hero-document-text" class="w-7 h-7" />
            </div>
            <h4 class="font-bold text-xl text-slate-900 dark:text-white mb-3">Pendaftaran Paperless</h4>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">Ajukan CV, Portofolio, dan Surat Pengantar langsung dari portal. Tidak perlu lagi mencetak dokumen fisik.</p>
          </div>
        </div>
        
        <!-- Feature 2 -->
        <div class="group relative bg-white dark:bg-slate-900 p-8 rounded-3xl shadow-sm ring-1 ring-slate-200 dark:ring-slate-700 hover:shadow-2xl hover:ring-indigo-600/50 dark:hover:ring-indigo-500/50 transition-all duration-300 hover:-translate-y-2">
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 to-transparent dark:from-indigo-900/10 dark:to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-indigo-100 to-indigo-50 dark:from-indigo-900/30 dark:to-indigo-800/30 text-indigo-600 dark:text-indigo-400 rounded-2xl flex items-center justify-center mb-6 shadow-inner">
              <.icon name="hero-qr-code" class="w-7 h-7" />
            </div>
            <h4 class="font-bold text-xl text-slate-900 dark:text-white mb-3">Presensi QR Code</h4>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">Catat kehadiran harian Anda hanya dengan memindai QR Code unik menggunakan sistem scanner dari Mentor.</p>
          </div>
        </div>
        
        <!-- Feature 3 -->
        <div class="group relative bg-white dark:bg-slate-900 p-8 rounded-3xl shadow-sm ring-1 ring-slate-200 dark:ring-slate-700 hover:shadow-2xl hover:ring-purple-600/50 dark:hover:ring-purple-500/50 transition-all duration-300 hover:-translate-y-2">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-50/50 to-transparent dark:from-purple-900/10 dark:to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-purple-100 to-purple-50 dark:from-purple-900/30 dark:to-purple-800/30 text-purple-600 dark:text-purple-400 rounded-2xl flex items-center justify-center mb-6 shadow-inner">
              <.icon name="hero-book-open" class="w-7 h-7" />
            </div>
            <h4 class="font-bold text-xl text-slate-900 dark:text-white mb-3">Logbook Mingguan</h4>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">Tulis laporan kemajuan setiap minggu dan dapatkan *feedback* langsung dari pembimbing Anda secara real-time.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-16 bg-slate-50 dark:bg-slate-800/50 border-t border-slate-100 dark:border-slate-800 relative overflow-hidden">
    <div class="absolute right-0 top-0 w-1/2 h-full bg-gradient-to-l from-blue-50 dark:from-blue-900/10 to-transparent pointer-events-none"></div>
    <div class="w-full px-6 lg:px-12 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white sm:text-4xl mb-6">Alur Pelaksanaan Magang</h2>
          <p class="text-lg text-slate-600 dark:text-slate-400 mb-10">Pahami tahapan kegiatan magang di UPA TIK dari awal hingga akhir untuk memastikan Anda tidak melewatkan proses apa pun.</p>
          
          <div class="space-y-6">
            <!-- Step 1 -->
            <div class="relative flex items-start gap-4">
              <div class="flex items-center justify-center w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 font-bold shrink-0">1</div>
              <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 w-full">
                <h4 class="font-bold text-slate-900 dark:text-white mb-1">Cari Lowongan</h4>
                <p class="text-sm text-slate-600 dark:text-slate-400">Lihat daftar lowongan yang tersedia dan lengkapi berkas pendaftaran Anda.</p>
              </div>
            </div>
            <!-- Step 2 -->
            <div class="relative flex items-start gap-4">
              <div class="flex items-center justify-center w-10 h-10 rounded-full bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 font-bold shrink-0">2</div>
              <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 w-full">
                <h4 class="font-bold text-slate-900 dark:text-white mb-1">Proses Seleksi</h4>
                <p class="text-sm text-slate-600 dark:text-slate-400">Tunggu proses verifikasi dokumen dan penetapan Mentor oleh Admin.</p>
              </div>
            </div>
            <!-- Step 3 -->
            <div class="relative flex items-start gap-4">
              <div class="flex items-center justify-center w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-bold shrink-0">3</div>
              <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 w-full">
                <h4 class="font-bold text-slate-900 dark:text-white mb-1">Pelaksanaan Magang</h4>
                <p class="text-sm text-slate-600 dark:text-slate-400">Lakukan presensi harian dengan QR Code dan kumpulkan Logbook mingguan.</p>
              </div>
            </div>
            <!-- Step 4 -->
            <div class="relative flex items-start gap-4">
              <div class="flex items-center justify-center w-10 h-10 rounded-full bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 font-bold shrink-0">4</div>
              <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 w-full">
                <h4 class="font-bold text-slate-900 dark:text-white mb-1">Penilaian Akhir</h4>
                <p class="text-sm text-slate-600 dark:text-slate-400">Selesaikan tugas akhir magang dan dapatkan sertifikat serta nilai dari UPA TIK.</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Illustration Image -->
        <div class="hidden lg:block">
          <div class="bg-white dark:bg-slate-900 p-4 rounded-3xl shadow-xl ring-1 ring-slate-200 dark:ring-slate-700 transform rotate-2 hover:rotate-0 transition-transform duration-500">
            <div class="aspect-square lg:aspect-[4/3] bg-slate-100 dark:bg-slate-800 rounded-2xl overflow-hidden relative group">
              <div class="absolute inset-0 bg-gradient-to-tr from-blue-600/30 to-indigo-600/30 z-10 group-hover:opacity-0 transition-opacity duration-500"></div>
              <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" alt="Students Working" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- Urgent Openings Section --%>
  <%= if @urgent_openings != [] do %>
    <section class="pb-16 bg-slate-50 dark:bg-slate-800/50 relative overflow-hidden">
      <div class="w-full relative z-10 px-6 lg:px-12">
        <div class="text-center mb-10">
          <h3 class="text-sm font-bold text-slate-700 dark:text-slate-300 uppercase tracking-widest bg-white/50 dark:bg-slate-800/50 backdrop-blur-sm inline-block px-4 py-1.5 rounded-full border border-slate-200 dark:border-slate-700">
            Lowongan Segera Ditutup
          </h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-7xl mx-auto">
          <%= for opening <- @urgent_openings do %>
            <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-lg shadow-indigo-100/20 dark:shadow-none hover:scale-105 transition-transform duration-300">
              <div class="flex justify-between items-start mb-4">
                <span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/30 px-2.5 py-1 rounded-md uppercase tracking-wider">
                  Sisa Kuota: <%= opening.quota %>
                </span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">
                  <%= Calendar.strftime(opening.closing_date, "%d %b") %>
                </span>
              </div>
              <h4 class="font-bold text-slate-900 dark:text-white leading-tight mb-2"><%= opening.title %></h4>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2"><%= if opening.division, do: opening.division.name, else: "-" %></p>
              <div class="mt-4 pt-4 border-t border-slate-50 dark:border-slate-800">
                <.link navigate={~p"/portal/lowongan/#{opening.id}"} class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 uppercase tracking-wider flex items-center gap-1">
                  Lihat Detail <.icon name="hero-arrow-right" class="w-3 h-3" />
                </.link>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-slate-900"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 opacity-90"></div>
    <!-- Decorative circles -->
    <div class="absolute top-0 left-0 w-96 h-96 bg-white dark:bg-slate-900 opacity-5 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-blue-400 opacity-20 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"></div>
    
    <div class="w-full relative z-10 px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6">Siap Memulai Perjalanan Karir Anda?</h2>
      <p class="text-xl text-blue-100 mb-10 max-w-7xl mx-auto">Bergabunglah dengan ratusan mahasiswa lainnya yang telah mendapatkan pengalaman berharga di UPA TIK.</p>
      <.link navigate={~p"/portal/lowongan"} class="inline-flex items-center justify-center rounded-2xl bg-white dark:bg-slate-900 px-10 py-5 text-center text-lg font-bold text-blue-900 shadow-xl hover:bg-blue-50 transition-all hover:scale-105">
        Lihat Lowongan Magang Sekarang
      </.link>
    </div>
  </section>
</.navbar>